rules_version = '2';
// G TRADERS — who may read and change what in the database.
// Upload in the Firebase console: Firestore Database > Rules > paste > Publish.
// The admin list here must match adminEmails in assets/js/config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['supportgtraders@gmail.com'];
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // site settings: everyone can read (features, limits, announcement); only the admin can change them
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // products (texts / pictures changed in the control panel): everyone reads, only the admin writes
    match /products/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PDF guides uploaded from the control panel, kept in pieces of < 1 MB
    match /files/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /chunks/{n} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Updates page: posts by the admin; members may like (only their own like) and comment
    match /posts/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount'])
        && request.resource.data.get('likes', {}).diff(resource.data.get('likes', {})).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.get('commentCount', 0) - resource.data.get('commentCount', 0)) in [-1, 0, 1]);

      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'photo', 'text', 'created'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.get('photo', '').size() < 60000;
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // a new account starts as an active free trial and cannot give itself limits, features or a long trial
      allow create: if isOwner(uid)
        && request.resource.data.plan == 'trial'
        && request.resource.data.status == 'active'
        && request.resource.data.trialEnds <= request.time.toMillis() + 400 * 86400000
        && !request.resource.data.keys().hasAny(['limits', 'features', 'note', 'role'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('photo', '').size() < 200000;
      // the user may only change their own profile fields and activity counters
      allow update: if isAdmin() || (isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'country', 'whatsapp', 'photo', 'stats', 'lastLogin', 'downloads'])
        && request.resource.data.get('photo', '').size() < 200000
        && request.resource.data.get('name', '').size() <= 60);
      allow delete: if isOwner(uid) || isAdmin();

      // popup messages from the admin
      match /inbox/{msg} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      }
    }
  }
}
