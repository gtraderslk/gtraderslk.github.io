rules_version = '2';
// G TRADERS — who may read and change what in the database.
// Upload in the Firebase console: Firestore Database > Rules > paste > Publish.
// The admin list here must match adminEmails in assets/js/config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['supportgtraders@gmail.com'];
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // site settings: everyone can read (features, limits, announcement); only the admin can change them
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // a new account starts as an active free trial and cannot give itself limits, features or a long trial
      allow create: if isOwner(uid)
        && request.resource.data.plan == 'trial'
        && request.resource.data.status == 'active'
        && request.resource.data.trialEnds <= request.time.toMillis() + 400 * 86400000
        && !request.resource.data.keys().hasAny(['limits', 'features', 'note', 'role'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('photo', '').size() < 200000;
      // the user may only change their own profile fields and activity counters
      allow update: if isAdmin() || (isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'country', 'whatsapp', 'photo', 'stats', 'lastLogin', 'downloads'])
        && request.resource.data.get('photo', '').size() < 200000
        && request.resource.data.get('name', '').size() <= 60);
      allow delete: if isOwner(uid) || isAdmin();

      // popup messages from the admin
      match /inbox/{msg} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      }
    }
  }
}
